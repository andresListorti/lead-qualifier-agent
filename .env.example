# Local environment only. Set your own disposable passwords; never commit .env.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
DATABASE_URL=mysql+pymysql://lead_app:REPLACE_ME@127.0.0.1:3306/leads
LLM_PROVIDER=fixture
# Optional; never enabled automatically by the presence of a key.
GEMINI_API_KEY=
GEMINI_MODEL=
# Explicit cost guard; only enable after verifying your existing key has no billing.
GEMINI_FREE_TIER_CONFIRMED=false
# Auth0 (public identifiers, not secrets). GET /leads fails closed (503) if unset.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://lead-qualifier-api
